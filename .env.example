# Lexora Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# OpenAI API Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=https://api.openai.com/v1

# Database Configuration
DATABASE_URL=postgresql://lexora:lexora123@postgres:5432/lexora

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# PostgreSQL (for docker-compose)
POSTGRES_USER=lexora
POSTGRES_PASSWORD=lexora123
POSTGRES_DB=lexora

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Model Paths
MODEL_PATH=/app/models/clause_risknet.onnx
CALIBRATION_PATH=/app/models/calibration.json
SKLEARN_MODEL_DIR=/app/models/sklearn

# Storage
STORAGE_PATH=/app/storage
MAX_UPLOAD_SIZE=10485760

# Logging
LOG_LEVEL=INFO
ENABLE_PROMPT_LOGGING=true

# Security
SECRET_KEY=dev-secret-key-change-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
